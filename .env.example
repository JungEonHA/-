# ---------------------------------------------------------------------------
# Notion 연동 설정 (서버 전용 — 절대 VITE_ 접두사를 붙이지 마세요)
#
# VITE_ 접두사가 붙은 변수만 프론트엔드 번들에 포함됩니다.
# 아래 값들은 접두사가 없으므로 서버(서버리스 함수)에서만 읽히며,
# 브라우저로 전송되지 않습니다.
# ---------------------------------------------------------------------------

# Notion Internal Integration Secret. https://www.notion.so/my-integrations 에서 발급
# 형식: ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (구형은 secret_...)
NOTION_TOKEN=

# 근무시간 데이터베이스 ID (32자리 hex, 하이픈 유무 무관)
# DB를 전체 페이지로 열었을 때 URL: notion.so/<workspace>/<DATABASE_ID>?v=<viewId>
NOTION_DATABASE_ID=

# Notion API 버전 (변경할 이유가 없으면 그대로 두세요)
NOTION_VERSION=2022-06-28

# 쓰기 허용 스위치. 실수로 운영 DB에 쓰는 것을 막기 위한 안전장치.
# "1" 이 아니면 서버는 읽기(스키마 조회)만 허용합니다.
NOTION_ALLOW_WRITE=1

# 선택: 앱 접근 제한용 공유 비밀번호.
# 설정하면 /api/notion/* 호출 시 헤더에 이 값이 있어야 합니다.
# Notion Embed 는 공개 URL 이므로, URL 이 노출될 수 있는 환경이면 설정을 권장합니다.
APP_ACCESS_KEY=
