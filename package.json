{
  "name": "worktime-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "실시간 출퇴근/근무시간 관리 웹앱 (Notion Embed)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json",
    "verify:deploy": "node scripts/verify-deploy-build.mjs",
    "notion:doctor": "vite-node scripts/notion-doctor.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
